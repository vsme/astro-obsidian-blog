---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { SITE } from "@/config";

const currentYear = new Date().getFullYear();
const icpNumber = SITE.icpNumber.trim();
const author = SITE.author.trim();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <div class="flex flex-col items-center gap-1 sm:flex-row">
      <span class="italic">联系我<span class="hidden sm:inline">：</span></span>
      <Socials centered />
    </div>
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>&#169; {currentYear}</span>
      {
        author && (
          <span class="mx-1 hidden sm:inline">|</span>
          <span class="mx-1">{author}</span>
        )
      }
      {
        icpNumber && (
          <span class="mx-1 hidden sm:inline">|</span>
          <a
            href="https://beian.miit.gov.cn/"
            target="_blank"
            rel="noopener noreferrer"
            class="break-words hover:text-accent hover:underline"
          >
            {icpNumber}
          </a>
        )
      }
    </div>
  </div>
</footer>
